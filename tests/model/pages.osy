// The pages an app writes around the kit's components — as bare as a page can be, so the tests drive the components.

using Osysharp.MailingLists;
using Osysharp.Ui;

[Route("/")]
[AllowAnonymous]
component KitHome() {
  render {
    Stack(gap: 4, p: 6) {
      Text("Mailing lists test shop");
      ListSignupForm("letter", "Yes — send me the monthly letter. I can leave at any time.", source: "home");
    }
  }
}

// The links a mail carries are grants: the platform checks each before its page opens.
[Route("/newsletter/confirm/{link}")] [AllowAnonymous] component KitConfirm(ListConfirmation link) { render { Box(p: 6) { ListConfirm(link); } } }
[Route("/newsletter/{link}")] [AllowAnonymous] component KitPreferences(ListReaderLink link) { render { Box(p: 6) { ListPreferences(link); } } }

/// What a link that does not check out opens instead — forged, expired, taken back.
[AllowAnonymous] component KitLinkGone() {
  render { Box(p: 6) { Text("That link has run out. Use the one in a more recent mail from us."); } }
}
app.Ui = new AppUi { InvalidLinkSurface = KitLinkGone };
[Route("/lists")] component KitDesk() { render { Box(p: 6) { DeskMailingLists(); } } }
[Route("/me")] component KitMe() {
  var me = Session.CurrentUser;
  render { Box(p: 6) { ListChoices(me.Email); } }
}
